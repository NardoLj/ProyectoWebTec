# PROYECTO FINAL - TECNOLOGIA WEB I
# Autor: Jheferson Velasco
# Pais: Peru
# Proyecto: Circle Rush - .NET 10

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ProyectoTecWeb.csproj ./
RUN dotnet restore ProyectoTecWeb.csproj
COPY . .
RUN dotnet publish ProyectoTecWeb.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_ENVIRONMENT=Production
ENV PORT=8080
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "ProyectoTecWeb.dll"]
