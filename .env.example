# Copia este archivo como .env y cambia la contraseña antes de ejecutar.
# .env está ignorado por Git y no debe subirse al repositorio.

API_CONTAINER_NAME=proyectotecweb-api
API_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

DOCKERHUB_USER=nardolj
IMAGE_NAME=proyectowebtec
IMAGE_TAG=2.0.0

# Puertos de release (Punto 7: cuatro instancias)
RELEASE_PORT_1=5001
RELEASE_PORT_2=5002
RELEASE_PORT_3=5003
RELEASE_PORT_4=5004

POSTGRES_CONTAINER_NAME=proyectotecweb-db
POSTGRES_HOST=postgres
POSTGRES_DB=proyectotecweb
POSTGRES_USER=proyectotecweb
POSTGRES_PASSWORD=cambia_esta_clave

# OAuth de Leonardo (Bolivia). Completar solo en .env, nunca en este archivo.
# Google: https://console.cloud.google.com/  -> callback http://localhost:8080/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications -> callback http://localhost:8080/signin-discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth de Argentina: Adalid (Twitch y Slack).
# Para HTTPS local: https://localhost:8443/signin-twitch y /signin-slack
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# HTTPS local para OAuth (solo completar la contraseña en .env privado)
HTTPS_PORT=8443
HOST_UID=1000
HOST_GID=1000
HTTPS_CERT_PASSWORD=
# OAuth de Perú: Jheferson (Dropbox y Spotify).
# Registra el callback exacto que use el navegador (HTTPS local o dominio público).
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
